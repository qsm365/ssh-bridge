# Copy to .env and set strong, unique values. Do not commit .env.
SSH_BRIDGE_POSTGRES_PASSWORD=
SSH_BRIDGE_ADMIN_PASSWORD=
SSH_BRIDGE_COOKIE_SECURE=false
SSH_BRIDGE_SSH_KEYS_DIR=./ssh-keys
SSH_BRIDGE_PORT=7408
# Optional build mirrors for restricted networks; defaults use official registries.
# SSH_BRIDGE_NPM_REGISTRY=https://registry.npmmirror.com
# SSH_BRIDGE_GOPROXY=https://goproxy.cn,direct
